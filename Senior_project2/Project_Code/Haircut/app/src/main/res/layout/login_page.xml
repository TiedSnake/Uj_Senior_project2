<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".login"
    >
        <ImageView
            android:id="@+id/imageView1"
            android:importantForAccessibility="no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/template"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <ImageView
            android:id="@+id/haircut_app_icon"
            android:importantForAccessibility="no"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/haircut_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/Login_label"
            />
        <TextView
            android:id="@+id/Login_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_page"
            android:textAlignment="center"
            android:textSize="40sp"
            app:layout_constraintTop_toBottomOf="@id/haircut_app_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/email_field"
            />
        <TextView
            android:id="@+id/Password_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_login_page"
            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/pwd_field"
            app:layout_constraintTop_toBottomOf="@id/email_field"
            app:layout_constraintBottom_toTopOf="@id/signup_button"
            android:layout_marginStart="5dp"/>
        <EditText
            android:id="@+id/pwd_field"
            android:autofillHints="password"
            android:layout_width="250dp"
            android:layout_height="48dp"
            android:ems="10"
            android:inputType="textPassword"
            android:background="#BBBBBB"
            android:textColorHint="#000000"
            android:textColor="#000000"
            android:hint="@string/pwd_hint"
            app:layout_constraintLeft_toRightOf="@id/Password_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/email_field"
            app:layout_constraintBottom_toTopOf="@id/signup_button"
            />

        <TextView
            android:id="@+id/Email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30sp"
            android:text="@string/email_label"
            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/email_field"
            app:layout_constraintTop_toBottomOf="@id/Login_label"
            app:layout_constraintBottom_toTopOf="@id/pwd_field"
            />

        <EditText
            android:id="@+id/email_field"
            android:autofillHints="emailAddress"
            android:layout_width="250dp"
            android:layout_height="48dp"
            android:inputType="textEmailAddress"
            android:background="#BBBBBB"
            android:textColorHint="#000000"
            android:textColor="#FFFFFF"
            android:hint="@string/email_hint"
            app:layout_constraintBottom_toTopOf="@id/pwd_field"
            app:layout_constraintLeft_toRightOf="@id/Email_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Login_label"
            />

        <Button
            android:id="@+id/signup_button"
            android:layout_width="315dp"
            android:layout_height="58dp"
            android:text="@string/login"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pwd_field"
            app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>