<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update_profile_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".frontend.UpdateProfile">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/template"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/haircut_app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:importantForAccessibility="no"
            android:src="@drawable/haircut_app_icon"
            app:layout_constraintBottom_toTopOf="@id/profile_label"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/profile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:textAlignment="center"
            android:textSize="45sp"
            app:layout_constraintBottom_toTopOf="@id/update_profile_f_name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/haircut_app_icon" />

        <EditText
            android:id="@+id/update_profile_f_name"
            android:layout_width="200dp"
            android:layout_height="48sp"
            android:autofillHints="name"
            android:background="#BBBBBB"
            android:ems="10"
            android:hint="@string/f_name_hint"
            android:inputType="textEmailAddress"
            android:text="Mike"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#000000"
            app:layout_constraintBottom_toTopOf="@id/update_profile_l_name"
            app:layout_constraintLeft_toRightOf="@id/update_profile_f_name_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_label" />

        <EditText
            android:id="@+id/update_profile_l_name"
            android:layout_width="200dp"
            android:layout_height="48sp"
            android:autofillHints="name"
            android:background="#BBBBBB"
            android:ems="10"
            android:hint="@string/lname_hint"
            android:inputType="textEmailAddress"
            android:text="Torino"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#000000"
            app:layout_constraintBottom_toTopOf="@id/update_profile_email_field"
            app:layout_constraintLeft_toRightOf="@id/Lname_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/update_profile_f_name" />

        <TextView
            android:id="@+id/update_profile_f_name_label"
            android:layout_width="160sp"
            android:layout_height="48sp"
            android:gravity="center"
            android:text="@string/first_name"
            android:textSize="23sp"
            app:layout_constraintBottom_toTopOf="@id/Lname_label"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/update_profile_f_name"
            app:layout_constraintTop_toBottomOf="@id/profile_label" />

        <TextView
            android:id="@+id/Lname_label"
            android:layout_width="160sp"
            android:layout_height="48sp"
            android:gravity="center"
            android:text="@string/last_name"
            android:textSize="23sp"
            app:layout_constraintBottom_toTopOf="@id/email_label"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/update_profile_l_name"
            app:layout_constraintTop_toBottomOf="@id/update_profile_f_name_label" />

        <TextView
            android:id="@+id/email_label"
            android:layout_width="160sp"
            android:layout_height="48sp"
            android:gravity="center"
            android:text="@string/email1"
            android:textSize="23sp"
            app:layout_constraintBottom_toTopOf="@id/Password_label"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/update_profile_email_field"
            app:layout_constraintTop_toBottomOf="@id/Lname_label" />

        <EditText
            android:id="@+id/update_profile_email_field"
            android:layout_width="200dp"
            android:layout_height="48sp"
            android:autofillHints="name"
            android:background="#BBBBBB"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:text="MikeT@gmail.com"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#000000"
            app:layout_constraintBottom_toTopOf="@id/update_profile_pwd_btn"
            app:layout_constraintLeft_toRightOf="@id/email_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/update_profile_l_name" />

        <TextView
            android:id="@+id/Password_label"
            android:layout_width="160sp"
            android:layout_height="48sp"
            android:gravity="center"
            android:text="@string/password"
            android:textAlignment="center"
            android:textSize="23sp"
            app:layout_constraintBottom_toTopOf="@id/progressBar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/update_profile_pwd_btn"
            app:layout_constraintTop_toBottomOf="@id/email_label" />


        <Button
            android:id="@+id/update_profile_pwd_btn"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:backgroundTint="#000000"
            android:text="update password"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:layout_constraintBottom_toTopOf="@id/progressBar"
            app:layout_constraintLeft_toRightOf="@id/Password_label"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/update_profile_email_field" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/update_profile_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/update_profile_pwd_btn" />

        <Button
            android:id="@+id/update_profile_btn"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:layout_marginTop="60sp"
            android:backgroundTint="#000000"
            android:text="@string/update_profile"
            android:textColor="#FFFFFF"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15sp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/update_profile_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar">

            <TextView
                android:id="@+id/update_profile_errorMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:textAlignment="center"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="20sp"
                android:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
