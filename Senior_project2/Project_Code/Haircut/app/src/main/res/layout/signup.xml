<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <ImageView
        android:id="@+id/imageView1"
        android:importantForAccessibility="no"
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:src="@drawable/template"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="490dp"
        android:text="@string/password1"
        android:textSize="25sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />

    <EditText
        android:id="@+id/editTextTextPassword2"
        android:textColorHint="000000"
        android:autofillHints="password"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="textPassword"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="490dp"
        android:background="#BBBBBB"
        android:textColor="#000000"
        android:hint="@string/pwd_hint"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="300dp"
        android:text="@string/first_name"
        android:textSize="25sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />

    <EditText
        android:id="@+id/Fname"
        android:autofillHints="name"
        android:textColorHint="000000"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:background="#BBBBBB"
        android:textColor="#000000"
        android:hint="@string/fname_hint"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="300dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="360dp"
        android:text="@string/last_name"
        android:textSize="25sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />

    <EditText
        android:id="@+id/Lname"
        android:autofillHints="name"
        android:textColorHint="000000"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:background="#BBBBBB"
        android:textColor="#000000"
            android:hint="@string/lname_hint"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="360dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="431dp"
        android:text="@string/email1"
        android:textSize="25sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />
    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:autofillHints="emailAddress"
        android:textColorHint="000000"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:background="#BBBBBB"
        android:textColor="#000000"
        android:hint="@string/email_hint"
        tools:layout_editor_absoluteX="170dp"
        tools:layout_editor_absoluteY="431dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        />

    <Button
        android:id="@+id/Login_button"
        android:layout_width="315dp"
        android:layout_height="58dp"
        android:text="@string/log_in1"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF"
        tools:layout_editor_absoluteX="49dp"
        tools:layout_editor_absoluteY="613dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""/>

    <ImageView
        android:id="@+id/haircut_app_icon"
        android:importantForAccessibility="no"
        android:layout_width="100dp"
        android:layout_height="200dp"
        android:translationX="120dp"
        android:translationY="20dp"

        android:src="@drawable/haircut_app_icon"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />
    <TextView
        android:id="@+id/Login_label"
        android:layout_width="250dp"
        android:layout_height="67dp"
        android:text="@string/signup2"
        android:textAlignment="center"
        android:textSize="30sp"
        tools:layout_editor_absoluteX="78dp"
        tools:layout_editor_absoluteY="240dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        app:layout_constraintVertical_bias="0.0" />


</androidx.constraintlayout.widget.ConstraintLayout>