<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Go Back Button -->
    <ImageButton
        android:id="@+id/go_back_button"
        android:layout_width="90sp"
        android:layout_height="60sp"
        android:background="?attr/selectableItemBackground"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="@string/go_back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/book_appointment__text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Calendar View -->
            <CalendarView
                android:id="@+id/calendar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- Selected Date -->
            <TextView
                android:id="@+id/selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/selected_date"
                android:textSize="18sp" />

            <!-- Available Times -->
            <TextView
                android:id="@+id/available_times_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/available_times"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <!-- Time slots (initially hidden) -->
            <LinearLayout
                android:id="@+id/time_slots_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Book Appointment Button -->
    <Button
        android:id="@+id/book_appointment_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/book_appointment_button"
        android:layout_marginTop="24dp" />

    <!-- Confirmation Message -->
    <TextView
        android:id="@+id/confirmation_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:visibility="gone" />
</LinearLayout>
