<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".frontend.shared.SignupAndLoginPage">

        <ImageView
            android:id="@+id/imageView1"
            android:importantForAccessibility="no"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/template"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <ImageView
            android:importantForAccessibility="no"
            android:id="@+id/haircut_app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/haircut_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/login_signup"
            />
        <TextView
            android:id="@+id/login_signup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_signup"
            android:textAlignment="center"
            android:textSize="40sp"
            app:layout_constraintTop_toBottomOf="@id/haircut_app_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/Login_label"

            />

        <TextView
            android:id="@+id/Login_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_registered1"
            android:layout_marginTop="60dp"
            android:textSize="35sp"
            app:layout_constraintTop_toBottomOf="@id/login_signup"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/signup_button"
            />

        <Button
            android:id="@+id/signup_button"
            android:layout_width="252dp"
            android:layout_height="97dp"
            android:backgroundTint="#000000"
            android:text="@string/login2"
            android:textColor="#FFFFFFFF"
            android:textSize="35sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/Signup_label"
            app:layout_constraintTop_toBottomOf="@id/Login_label" />

        <TextView
            android:id="@+id/Signup_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/first_time1"
            android:textSize="35sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/Signup_button"
            app:layout_constraintTop_toBottomOf="@id/signup_button"
            />

        <Button
            android:id="@+id/Signup_button"
            android:layout_width="252dp"
            android:layout_height="97dp"
            android:layout_marginBottom="80dp"
            android:backgroundTint="#000000"
            android:text="@string/signup"
            android:textColor="#FFFFFFFF"
            android:textSize="35sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Signup_label"
            />
</androidx.constraintlayout.widget.ConstraintLayout>