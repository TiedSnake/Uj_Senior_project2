<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView1"
        android:importantForAccessibility="no"
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:src="@drawable/template"
        app:layout_constraintBottom_toTopOf="@android:id/empty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@android:id/empty"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/haircut_app_icon"
        android:importantForAccessibility="no"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/haircut_app_icon"
        android:translationX="110dp"
        android:translationY="20dp"
        app:layout_constraintBottom_toTopOf="@android:id/empty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/Login_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/already_registered1"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="80dp"
        tools:layout_editor_absoluteY="280dp" />

    <Button
        android:id="@+id/Login"
        android:layout_width="252dp"
        android:layout_height="97dp"
        android:backgroundTint="#000000"
        android:text="@string/login2"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""

        app:layout_constraintEnd_toStartOf=""
        tools:layout_editor_absoluteX="75dp"
        tools:layout_editor_absoluteY="318dp" />

    <TextView
        android:id="@+id/Signup_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/first_time1"
        android:textSize="30sp"
        tools:layout_editor_absoluteX="135dp"
        tools:layout_editor_absoluteY="440dp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""
        app:layout_constraintEnd_toStartOf=""
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf=""
        app:layout_constraintTop_toTopOf=""
        app:layout_constraintVertical_bias="0.0"
        />

    <Button
        android:id="@+id/Signup"
        android:layout_width="252dp"
        android:layout_height="97dp"
        android:backgroundTint="#000000"
        android:text="@string/signup1"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf=""
        app:layout_constraintEnd_toEndOf=""

        app:layout_constraintEnd_toStartOf=""
        tools:layout_editor_absoluteX="75dp"
        tools:layout_editor_absoluteY="480dp" />
</androidx.constraintlayout.widget.ConstraintLayout>