<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".customer">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/haircut_cus_page"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="@string/find_your_barber"
        android:textColor="#808080"
        android:textSize="19sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Sidebar Menu -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sidebarMenu"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- About Us Option as Button -->
        <Button
            android:id="@+id/sidebarOption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/About_us"
            android:padding="16dp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Option as Button -->
        <Button
            android:id="@+id/sidebarOption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_customer"
            android:padding="16dp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/sidebarOption1" />

        <!-- Book Appointment Option as Button -->
        <Button
            android:id="@+id/sidebarOption3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/book_an_appointment"
            android:padding="16dp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/sidebarOption2" />

        <!-- Chat Option as Button -->
        <Button
            android:id="@+id/sidebarOption4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_with_barber"
            android:padding="16dp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/sidebarOption3" />

        <!-- Sign Out Option as Button -->
        <Button
            android:id="@+id/sidebarOption5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_out_button_customer"
            android:padding="16dp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/sidebarOption4" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/menuImageButton"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/open_sidebar_menu"
        android:src="@drawable/menu_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNearby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/nearby_cus_page"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <!-- Nearby Barber Shop Item 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nearbyBarber1"
        android:layout_width="0dp"
        android:layout_height="143dp"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNearby">

        <TextView
            android:id="@+id/nearbyBarberName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sheraton_salon"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nearbyBarberName2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/capo_salon_cus_page"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/nearbyBarberName1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="#80FFFFFF"
            android:padding="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvPopularBarbershop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/popular_barbershop"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyBarber1" />

    <!-- Popular Barbershop List -->
    <LinearLayout
        android:id="@+id/popularBarberList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="228dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPopularBarbershop">

        <TextView
            android:id="@+id/popularBarberName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/sheraton_salon_cus_page"
            android:textColor="@android:color/black"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
