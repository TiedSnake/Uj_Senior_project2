<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/haircut_cus_page"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="@string/find_your_barber"
        android:textColor="#808080"
        android:textSize="19sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/menuImageButton"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_cus_page"
        android:src="@drawable/menu_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/tvNearby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/nearby_cus_page"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <!-- Nearby Barber Shop Item 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nearbyBarber1"
        android:layout_width="0dp"
        android:layout_height="143dp"
        android:layout_marginTop="16dp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNearby">

        <TextView
            android:id="@+id/nearbyBarberName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sheraton_salon"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/nearbyBarberImage2"
            android:layout_width="145dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/nearby_shop"
            android:scaleType="centerCrop"
            android:src="@drawable/salon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nearbyBarberName1" />

        <ImageView
            android:id="@+id/nearbyBarberImage1"
            android:layout_width="145dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/nearby_shop"
            android:scaleType="centerCrop"
            android:src="@drawable/capo_salon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nearbyBarberName1" />

        <TextView
            android:id="@+id/nearbyBarberName2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/capo_salon_cus_page"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/nearbyBarberImage1"
            app:layout_constraintEnd_toEndOf="@id/nearbyBarberImage1"
            app:layout_constraintBottom_toTopOf="@id/nearbyBarberImage1"
            android:background="#80FFFFFF"
            android:padding="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvPopularBarbershop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/popular_barbershop"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearbyBarber1" />

    <!-- Popular Barbershop List -->
    <LinearLayout
        android:id="@+id/popularBarberList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="228dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPopularBarbershop">

        <ImageView
            android:id="@+id/popularImage2"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/popular_shop"
            android:rotationX="1"
            android:scaleType="centerCrop"
            android:src="@drawable/salon" />

        <TextView
            android:id="@+id/popularBarberName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/sheraton_salon_cus_page"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/popularImage1"
            android:layout_width="123dp"
            android:layout_height="29dp"
            android:contentDescription="@string/popular_shop"
            android:rotationX="1"
            android:scaleType="centerCrop"
            android:src="@drawable/stars5"
             />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
