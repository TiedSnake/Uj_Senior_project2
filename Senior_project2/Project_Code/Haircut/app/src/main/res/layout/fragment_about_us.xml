<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".frontend.fragment_about_us">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Title -->
        <ImageView
            android:importantForAccessibility="no"
            android:id="@+id/haircut_app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/haircut_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/aboutus" />

        <TextView
            android:id="@+id/aboutus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_us"
            android:textAlignment="center"
            android:textSize="50sp"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/haircut_app_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvAboutUsText" />

        <!-- About Us Text -->
        <TextView
            android:id="@+id/tvAboutUsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/about_us_content"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:padding="16dp"
            android:lineSpacingExtra="8dp"
            app:layout_constraintTop_toBottomOf="@id/aboutus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
