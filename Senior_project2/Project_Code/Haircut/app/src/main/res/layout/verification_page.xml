<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".frontend.CodeVerification">

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:src="@drawable/template"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/haircut_app_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:importantForAccessibility="no"
        android:src="@drawable/haircut_app_icon"
        app:layout_constraintBottom_toTopOf="@id/password_recovery_label"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/password_recovery_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verification_code"
        android:textAlignment="center"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@id/verification_code_field"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/haircut_app_icon" />

    <TextView
        android:id="@+id/verification_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verification_code"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/new_password_label"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/verification_code_field"
        app:layout_constraintTop_toBottomOf="@id/password_recovery_label" />

    <EditText
        android:id="@+id/verification_code_field"
        android:layout_width="210dp"
        android:layout_height="48dp"
        android:autofillHints="emailAddress"
        android:background="#BBBBBB"
        android:hint="@string/verification_code_hint"
        android:inputType="textEmailAddress"
        android:textColor="#FFFFFF"
        android:textColorHint="#000000"
        app:layout_constraintBottom_toTopOf="@id/new_password_field"
        app:layout_constraintLeft_toRightOf="@id/verification_code_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password_recovery_label" />

    <TextView
        android:id="@+id/new_password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Password"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/verify_new_password_label"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/new_password_field"
        app:layout_constraintTop_toBottomOf="@id/verification_code_label" />


    <EditText
        android:id="@+id/new_password_field"
        android:layout_width="210dp"
        android:layout_height="48dp"
        android:autofillHints="emailAddress"
        android:background="#BBBBBB"
        android:hint="@string/verification_code_hint"
        android:inputType="textEmailAddress"
        android:textColor="#FFFFFF"
        android:textColorHint="#000000"
        app:layout_constraintBottom_toTopOf="@id/verify_new_password_field"
        app:layout_constraintLeft_toRightOf="@id/new_password_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verification_code_field" />

    <TextView
        android:id="@+id/verify_new_password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retype new Password"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/verify_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/verify_new_password_field"
        app:layout_constraintTop_toBottomOf="@id/new_password_label" />

    <EditText
        android:id="@+id/verify_new_password_field"
        android:layout_width="210dp"
        android:layout_height="48dp"
        android:autofillHints="emailAddress"
        android:background="#BBBBBB"
        android:hint="@string/verification_code_hint"
        android:inputType="textEmailAddress"
        android:textColor="#FFFFFF"
        android:textColorHint="#000000"
        app:layout_constraintBottom_toTopOf="@id/verify_btn"
        app:layout_constraintLeft_toRightOf="@id/verify_new_password_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_password_field" />


    <Button
        android:id="@+id/verify_btn"
        android:layout_width="315dp"
        android:layout_height="58dp"
        android:backgroundTint="#000000"
        android:text="Verify"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/reset_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verify_new_password_field" />

    <Button
        android:id="@+id/reset_btn"
        android:layout_width="315dp"
        android:layout_height="58dp"
        android:backgroundTint="#000000"
        android:text="@string/reset"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verify_btn" />


    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reset_btn"/>

</androidx.constraintlayout.widget.ConstraintLayout>