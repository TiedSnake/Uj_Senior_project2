{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "ES6",
    "lib": ["es6", "dom"]
  },
  "compileOnSave": true,
  "include": [
    "**/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
